// Prisma 스키마 - 숙박 예약 플랫폼 DB 설계
// Supabase(PostgreSQL) 또는 로컬 PostgreSQL 사용

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- 사용자 ----------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // 이메일 회원가입 시 해시된 비밀번호 (OAuth 사용자는 null)
  emailVerified DateTime? // 이메일 인증 완료 시각 (인증 전 null)
  name          String?
  image         String?
  phone         String?   // 전화번호 (선택)
  role          String    @default("user") // "user" | "admin"
  /// 메시지창에서 상대방 메시지 자동 번역 (게스트: 일→한, 호스트: 한→일)
  autoTranslateEnabled Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]  // NextAuth OAuth·이메일 연동
  sessions Session[]  // NextAuth 세션 (JWT 사용 시 미사용 가능)
  listings Listing[]  // 호스트로 등록한 숙소
  bookings Booking[]
  reviews  Review[]
  messagesSent Message[]
  wishlists Wishlist[]
  posts    Post[]   // 운영자 블로그 (admin 전용)
  notifications Notification[]
  scheduledMessageTemplates ScheduledMessageTemplate[] @relation("HostTemplates")
  pushSubscriptions PushSubscription[]
}

// NextAuth OAuth·이메일 연동
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token                  String?
  session_state             String?
  refresh_token_expires_in  Int?    // 카카오 OAuth용

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth 이메일 매직 링크
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ---------- 블로그 (SEO·운영자 전용) ----------
model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique  // URL용 (예: tokyo-minbak-guide)
  excerpt     String?   // 메타 설명·목록 요약
  body        String
  coverImage  String?   // 대표 이미지 URL
  publishedAt DateTime? // null = 비공개(초안)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([slug])
}

// ---------- 숙소 ----------
model Listing {
  id          String   @id @default(cuid())
  title       String
  /// 管理者・ホストがダッシュボードで識別するための表示名（日本語可）。未設定時は title を表示。
  hostDisplayName String?
  location    String   // 예: "신주쿠구, 도쿄" 또는 "다카다노바바역 도보 6분"
  description String? @default("")
  /// 구글 지도 등 외부 지도 서비스 링크 (선택)
  mapUrl      String?
  /// 숙소 소개 영상 URL (자체 업로드, 50MB 이하, 인스타 릴스 비율 9:16)
  videoUrl    String?
  pricePerNight Int    // 1박 가격 (JPY, Phase 2 저장 통화)
  cleaningFee   Int    @default(0) // 청소비 (JPY, 1회)
  imageUrl    String   // 대표 이미지 URL
  /// 기본 요금에 포함되는 인원 수 (명)
  baseGuests  Int      @default(2)
  /// 최대 인원 수 (명)
  maxGuests   Int      @default(2)
  /// 기본 인원 초과 1인당 1박 추가 요금 (JPY)
  extraGuestFee Int    @default(0)
  /// 월별 요금 배수 (기본 1.0). 예: 1월=1.1이면 1월은 기본 요금의 110%
  januaryFactor   Float @default(1.0)
  februaryFactor  Float @default(1.0)
  marchFactor     Float @default(1.0)
  aprilFactor     Float @default(1.0)
  mayFactor       Float @default(1.0)
  juneFactor      Float @default(1.0)
  julyFactor      Float @default(1.0)
  augustFactor    Float @default(1.0)
  septemberFactor Float @default(1.0)
  octoberFactor   Float @default(1.0)
  novemberFactor  Float @default(1.0)
  decemberFactor  Float @default(1.0)
  bedrooms    Int      @default(1)
  beds        Int      @default(1)
  baths       Int      @default(1)
  /// 전용 면적 (㎡). 선택 입력.
  areaSqm     Int?
  /// 화장실과 욕실(샤워·욕조) 분리 여부. 일본 숙소용.
  bathroomToiletSeparate Boolean @default(false)
  isPromoted  Boolean  @default(false) // 직영숙소(프로모션대상) 여부
  /// 즉시 예약 허용: true면 호스트 승인 없이 바로 결제 진행
  instantBooking Boolean @default(false)
  /// 취소 정책: "flexible" | "moderate" | "strict"
  cancellationPolicy String @default("flexible")
  /// 주의사항 (줄바꿈으로 구분, 각 줄이 하나의 항목)
  houseRules  String?  @default("")
  /// 숙소 타입: "detached_house"(단독주택) | "apartment"(아파트)
  propertyType String? @default("apartment")
  /// 게재 상태: "pending"(승인대기) | "approved"(게재) | "rejected"(거절). 어드민 승인 후에만 검색·상세 노출.
  status         String    @default("pending")
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectedReason String?
  /// OTA 노출 숨김: true면 검색·상세·홈에 노출하지 않음 (호스트는 목록에서 조회·토글 가능)
  hidden         Boolean   @default(false)
  /// 관리자 인증 숙소 (신뢰 배지 표시)
  isVerified     Boolean   @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ListingCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // OTA/PMS 캘린더 연동 (임시: iCal/ICS. 추후 Beds24 등 API 연동 시 동일 blocked-dates 파이프라인 사용)
  icalImportUrls String? @default("[]") // JSON array of ICS URLs to import (Airbnb, Beds24 export, etc.)

  /// Beds24 API V2 연동: true면 블록일 조회·예약 전송에 API 사용
  beds24Enabled Boolean @default(false)
  /// Beds24 프로퍼티 ID (propId)
  beds24PropId  String?
  /// Beds24 룸 ID (roomId)
  beds24RoomId  String?
  /// Beds24 계정 식별자 (관리자 전용). 값이 있으면 BEDS24_REFRESH_TOKEN_{accountKey} 환경변수 토큰 사용.
  /// null(기본)이면 공용 BEDS24_REFRESH_TOKEN 으로 fallback → 기존 숙소 동작 유지.
  beds24AccountKey String?
  /// Beds24 가격 컬럼 인덱스 (1~16). tokyominbak 레이트가 p1~p16 중 어디인지. null=4(p4)
  beds24OfferIndex Int?
  /// Beds24 가격 배율. 1=그대로, 0.5=-50%. Beds24 연동가격(価格from+オフセット) 미반환 시 수동 적용
  beds24PriceMultiplier Float?
  /// Beds24 가격 배율 월별 (1=그대로). 미설정 시 beds24PriceMultiplier 또는 1 사용
  beds24JanuaryFactor   Float?  @map("beds24_january_factor")
  beds24FebruaryFactor  Float?  @map("beds24_february_factor")
  beds24MarchFactor     Float?  @map("beds24_march_factor")
  beds24AprilFactor     Float?  @map("beds24_april_factor")
  beds24MayFactor       Float?  @map("beds24_may_factor")
  beds24JuneFactor      Float?  @map("beds24_june_factor")
  beds24JulyFactor      Float?  @map("beds24_july_factor")
  beds24AugustFactor    Float?  @map("beds24_august_factor")
  beds24SeptemberFactor Float?  @map("beds24_september_factor")
  beds24OctoberFactor   Float?  @map("beds24_october_factor")
  beds24NovemberFactor  Float?  @map("beds24_november_factor")
  beds24DecemberFactor  Float?  @map("beds24_december_factor")
  /// 최소 숙박 일수. null=1박(기본)
  minStayNights Int?
  /// 최대 숙박 일수. null=제한 없음
  maxStayNights Int?
  /// 체크인 시간 (HH:mm, 예: 15:00). 미설정 시 상세에서 표시 안 함
  checkInTime   String?
  /// 체크아웃 시간 (HH:mm, 예: 11:00). 미설정 시 상세에서 표시 안 함
  checkOutTime  String?

  bookings     Booking[]
  reviews      Review[]
  listingAmenities ListingAmenity[]
  images       ListingImage[]
  availability ListingAvailability[]
  wishlists    Wishlist[]
  scheduledMessageTemplateListings ScheduledMessageTemplateListing[]
  /// AI 리뷰 요약 캐시(옵션). Listing 행 자체를 변경하지 않는 보조 테이블과 1:1
  reviewSummary                    ListingReviewSummary?

  @@index([userId]) // 호스트별 숙소 조회 최적화
}

// 위시리스트 (찜)
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

// 날짜별 요금·예약 불가
model ListingAvailability {
  id             String   @id @default(cuid())
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date           String   // YYYY-MM-DD
  pricePerNight  Int?     // null이면 숙소 기본 요금 사용 (JPY)
  available      Boolean  @default(true) // false면 예약 불가

  @@unique([listingId, date])
  @@index([listingId])
}

// 숙소 이미지 (다중)
model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)

  @@index([listingId])
}

// ---------- 숙소 카테고리 (도미토리, 개인실, 아파트 등, Framer CMS처럼 등록 시 새로 만들기 가능) ----------
model ListingCategory {
  id        String   @id @default(cuid())
  name      String   @unique  // 예: "도미토리", "개인실", "콘도"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  listings Listing[]
}

// ---------- 편의시설 (WiFi, 주방 등) ----------
model Amenity {
  id   String @id @default(cuid())
  name String @unique // 예: "WiFi", "주방", "TV"
  icon String?        // 이모지 또는 아이콘명

  listings ListingAmenity[]
}

// 숙소 ↔ 편의시설 다대다
model ListingAmenity {
  listingId String
  amenityId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
}

// ---------- 예약 ----------
model Booking {
  id              String   @id @default(cuid())
  checkIn         DateTime
  checkOut        DateTime
  guests          Int      @default(1)
  totalPrice      Int      // 총 결제 금액 (JPY)
  status          String   @default("pending") // pending | confirmed | cancelled
  paymentStatus   String   @default("pending") // pending | paid | refunded | failed
  rejectedByHost  Boolean? @default(false) // 취소 시 호스트 거절 여부 (기록용)
  /// 예약 확인 페이지에서 입력한 예약자 성함 (PG 구매자명·이메일 수신자 표시 등에 사용)
  guestName       String?
  guestPhone      String?  // 예약 확인 페이지에서 입력한 긴급연락용 전화번호 (PG 결제 시 사용)
  billingKey            String?   // 포트원 빌링키 (카드 등록 시 발급)
  paymentMethod         String    @default("immediate") // immediate(즉시결제) | deferred(빌링키 후불결제)
  scheduledPaymentDate  DateTime? // 자동 결제 예정일 (체크인 7일 전)
  /// 호스트 승인 시각 (승인제 숙소에서 accept 시 기록, 24시간 미결제 자동 취소 기준)
  confirmedAt       DateTime?
  /// 결제 리마인더 발송 여부 (24시간 기한 중 20시간 경과 시 1회 발송)
  paymentReminderSent Boolean @default(false)
  /// 정산 상태: null(미정산) | "completed"(정산완료)
  settlementStatus  String?
  /// 정산 완료 시각 (운영자가 완료 체크한 시점)
  settlementAt      DateTime?
  /// 정산 처리 메모 (운영자 입력, 선택)
  settlementNote    String?
  /// Beds24 예약 ID (POST /bookings 성공 시 응답에서 저장, 취소 시 DELETE /bookings 호출에 사용)
  beds24BookId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversation Conversation?
  transactions PaymentTransaction[]

  @@index([listingId, checkIn, checkOut]) // 예약 가능 여부 검색용
  @@index([status, paymentStatus])        // 상태별 조회 최적화
  @@index([userId])                        // 사용자별 예약 조회
  @@index([paymentMethod, paymentStatus, scheduledPaymentDate]) // Cron Job 빌링키 결제 조회용
  @@index([settlementStatus]) // 정산 관리 조회용
}

// ---------- 결제 트랜잭션 (포트원 결제 이력) ----------
model PaymentTransaction {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId       String   @unique // 포트원 paymentId (결제창 요청 시 생성한 ID)
  transactionId   String?  // 포트원 transactionId (PG사 응답)
  amount          Int      // 결제 금액
  status          String   @default("pending") // pending | paid | failed | cancelled | refunded
  method          String?  // CARD, VIRTUAL_ACCOUNT 등
  pgProvider      String?  // KG이니시스 등
  failReason      String?  // 실패/취소 사유
  rawResponse     String?  // 포트원 응답 원본 JSON
  verifiedAt      DateTime? // 서버 측 검증 완료 시각
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bookingId])
  @@index([paymentId])
}

// ---------- 메시지 (예약 단위 대화) ----------
model Conversation {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages Message[]
  scheduledMessages ScheduledMessage[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  /// 메시지 첨부 이미지 URL (1장, 사진만)
  imageUrl       String?
  createdAt      DateTime @default(now())

  translationCache TranslationCache[]

  @@index([conversationId, createdAt])
}

/// 메시지 자동 번역 결과 캐시 (동일 메시지·목표언어 재번역 방지)
model TranslationCache {
  id             String   @id @default(cuid())
  messageId      String
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  targetLang     String   // "ko" | "ja"
  translatedText String
  createdAt      DateTime @default(now())

  @@unique([messageId, targetLang])
  @@index([messageId])
}

// ---------- 알림 (앱 내 벨 아이콘·드롭다운) ----------
model Notification {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String    // booking_approved, booking_rejected, new_message, new_booking_request, guest_payment_completed, booking_cancelled
  title           String
  linkPath        String?
  linkLabel       String?
  bookingId       String?
  conversationId  String?
  listingId       String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ---------- 예약 메시지 템플릿 (호스트가 생성·관리) ----------
model ScheduledMessageTemplate {
  id         String   @id @default(cuid())
  hostId     String
  host       User     @relation("HostTemplates", fields: [hostId], references: [id], onDelete: Cascade)
  title      String
  body       String
  /// "booking_confirmed" | "before_checkin" | "after_checkin" | "before_checkout" | "after_checkout"
  trigger    String
  /// 트리거 기준 오프셋 (일). before_checkin+offsetDays=2 → 체크인 2일 전
  offsetDays Int      @default(0)
  /// 전송 시각 (HH:MM, JST 기준)
  sendTime   String   @default("10:00")
  /// 0件 = 호스트의 전체 숙소에 적용. 1件以上 = 指定したリスティングのみ
  templateListings ScheduledMessageTemplateListing[]
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scheduledMessages ScheduledMessage[]

  @@index([hostId, enabled])
}

/// テンプレート適用リスティング (0件=全件適用、1件以上=指定のみ)
model ScheduledMessageTemplateListing {
  templateId String
  listingId  String
  template   ScheduledMessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([templateId, listingId])
  @@index([listingId])
}

// ---------- 예약 메시지 인스턴스 (예약별 자동 생성) ----------
model ScheduledMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  templateId     String
  template       ScheduledMessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// UTC로 저장 (생성 시 JST→UTC 변환)
  scheduledAt    DateTime
  /// 단축 코드가 치환된 최종 본문
  renderedBody   String
  /// "pending" | "sent" | "skipped"
  status         String   @default("pending")
  sentAt         DateTime?
  sentManually   Boolean  @default(false)
  /// 전송된 Message ID
  messageId      String?  @unique
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([status, scheduledAt])
}

// AI 리뷰 요약 캐시 (온디맨드 생성, 24시간 유효). 숙소/예약 본문과 분리된 보조 데이터만 보관.
model ListingReviewSummary {
  id                 String   @id @default(cuid())
  listingId          String   @unique
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  prosJson           String   // JSON array of strings (좋은 점)
  consJson           String   // JSON array of strings (아쉬운 점)
  recommendedForJson  String?  // JSON array of strings (이런 분에게 추천해요)
  generatedAt        DateTime @updatedAt
}

// ---------- 리뷰 ----------
model Review {
  id        String   @id @default(cuid())
  rating   Int      // 1~5
  body     String?
  createdAt DateTime @default(now())
  /// 어드민이 편집한 게스트 표시 이름 (없으면 user.name 사용)
  authorDisplayName String?

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  images    ReviewImage[]
  // 과거에는 @@unique([listingId, userId]) 로 "숙소당 사용자 1인 1리뷰"를 강제했지만,
  // 관리자(admin)가 동일 숙소에 여러 리뷰를 등록할 수 있도록 제거했습니다.
  @@index([listingId, userId])
}

// ---------- 리뷰 이미지 ----------
model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)

  @@index([reviewId])
}

// PWA 웹 푸시 구독 (호스트 결제 알림 등)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}
