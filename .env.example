# Database (PostgreSQL - Vercel 배포용)
# Neon: https://neon.tech → 프로젝트 생성 후 Connection string 복사
# Supabase: 대시보드 → Project Settings → Database 에서 Connection string 복사
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# DIRECT_URL="postgresql://user:pass@host:5432/db"  # Neon은 DATABASE_URL과 동일해도 됨
DATABASE_URL=""
DIRECT_URL=""

# NextAuth (필수 - 구글 로그인 사용 시에도 반드시 설정)
# NEXTAUTH_SECRET: 터미널에서 openssl rand -hex 32 실행 후 나온 값
NEXTAUTH_SECRET="openssl rand -hex 32 로 생성한 랜덤 문자열"
NEXTAUTH_URL="http://localhost:3000"

# 이메일·canonical·sitemap·OG 등에 쓰이는 공개 URL. Vercel 배포 시 필수.
# 미설정이면 VERCEL_URL(xxx.vercel.app) 사용. tokyominbak.net 운영 시 반드시 설정 권장.
# NEXT_PUBLIC_APP_URL="https://tokyominbak.net"
NEXT_PUBLIC_APP_URL=""

# OAuth - 구글 로그인 (docs/OAUTH_SETUP.md 1번 참고)
# Google Cloud Console → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID (웹) → 승인된 리디렉션 URI 에 http://localhost:3000/api/auth/callback/google 추가
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 카카오: https://developers.kakao.com/console/app → 카카오 로그인 → 웹 → REST API 키, 시크릿
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
# 카카오톡 채널 1:1 채팅 URL (숙소추천 상담). 미설정 시 constants.ts KAKAO_LINK fallback
# NEXT_PUBLIC_KAKAO_CHANNEL_CHAT_URL="https://pf.kakao.com/_nxhNjn/chat"

# 네이버: https://developers.naver.com/apps → 애플리케이션 등록 → Client ID, Client Secret
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# 도쿄민박 공식 계정 이메일 (예약/승인 시 채팅 자동 메시지 발신자, 시드에서 생성)
# 미설정 시 official@tokyominbak.com 사용
# OFFICIAL_ACCOUNT_EMAIL="official@tokyominbak.com"

# 개발기간 한정: 로그인 없이 모든 페이지 접근 허용 (배포 시 제거)
# DEV_SKIP_AUTH=1

# 히어로 비디오 배경 (선택) - 미설정 시 Framer 기본 URL 사용
# NEXT_PUBLIC_HERO_VIDEO_URL="https://example.com/hero.mp4"
# 히어로 배경 이미지 (선택) - 비디오 미재생 시 표시. 미설정 시 public/hero-bg.jpg 또는 기본 도쿄 이미지
# NEXT_PUBLIC_HERO_IMAGE_URL="https://example.com/hero.jpg"

# 포트원(KG이니시스) PG - 카드/간편결제 (예약 확인 페이지에서 결제하기 사용 시)
# https://portone.io 콘솔 → 채널 → KG이니시스 등 연동 후 Store ID, Channel Key 복사
# NEXT_PUBLIC_PORTONE_STORE_ID="store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# NEXT_PUBLIC_PORTONE_CHANNEL_KEY="channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# 포트원 모바일 결제 채널 키 (선택 - KG이니시스 모바일 모듈용)
# KG이니시스는 PC/모바일 결제 모듈이 별도입니다. 모바일 전용 채널을 포트원에서 추가한 뒤 Channel Key 입력.
# 미설정 시 PC 채널(PORTONE_CHANNEL_KEY)로 시도하며, 모바일에서 실패 시 이메일 결제 링크 폴백 제공.
# NEXT_PUBLIC_PORTONE_CHANNEL_KEY_MOBILE="channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# 포트원 빌링키(정기결제) 채널 키 (선택 - 미설정 시 항상 즉시결제)
# 설정 방법: docs/포트원-빌링키-채널-설정.md 참고
# 포트원 콘솔에서 "결제창 일반/정기결제" 모듈로 채널 추가 후 Channel Key 입력
# NEXT_PUBLIC_PORTONE_BILLING_CHANNEL_KEY="channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# 포트원 V2 API Secret (서버 측 결제 검증 / 환불 처리용, 필수)
# https://portone.io 콘솔 → API Keys → V2 Secret Key 복사
# ⚠️ 이 키는 서버에서만 사용되며, NEXT_PUBLIC_ 접두사가 없어야 합니다.
# Webhook URL: {배포URL}/api/webhooks/portone 을 포트원 콘솔에서 등록하세요.
# PORTONE_API_SECRET="portone-api-secret-xxxxxxxx"

# 포트원 웹훅 시크릿 (선택) - 결제알림(Webhook) 관리에서 발급한 whsec_... 값. 서명 검증 시 사용.
# 실제 값은 .env에만 넣고, Git에 커밋하지 마세요.
# PORTONE_WEBHOOK_SECRET="whsec_xxxxxxxx"

# 운영/테스트 모드 표시용 플래그 (선택)
# true면 일부 환불 경로에서 PG 호출을 생략하므로, Production에서는 false 또는 미설정 권장
# NEXT_PUBLIC_PORTONE_TEST_MODE=false

# 개발/프리뷰 전용: 모의 결제 (실제 PG 호출 없이 결제 완료 처리). 프로덕션에는 설정하지 마세요.
# 로컬 또는 Vercel Preview에서 ENABLE_MOCK_PAYMENT=1, NEXT_PUBLIC_ENABLE_MOCK_PAYMENT=1 설정 시
# 결제 페이지에 "테스트 결제 (모의 · 카드 없음)" 버튼이 나타나며, 클릭만으로 결제 완료 플로우를 테스트할 수 있습니다.
# ENABLE_MOCK_PAYMENT=1
# NEXT_PUBLIC_ENABLE_MOCK_PAYMENT=1

# 이메일 발송 (Resend) - 회원가입 이메일 인증용
# https://resend.com 가입 → API Keys → Create API Key
# 도메인 미인증 시: onboarding@resend.dev 사용 (무료 100통/일)
# 도메인 인증 후: EMAIL_FROM="도쿄민박 <noreply@tokyominbak.net>" 등
RESEND_API_KEY=""
EMAIL_FROM="도쿄민박 <onboarding@resend.dev>"
# 숙소추천 상담 리드 알림 수신 (Phase 1B). RESEND_API_KEY와 함께 설정
# RECOMMENDATION_LEAD_NOTIFY_EMAIL="minbaktokyo@gmail.com"

# 이미지 저장소 - Cloudinary (Vercel Blob Forbidden 시 대안, docs/Cloudinary-설정.md)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Vercel Cron Job 인증 시크릿 (필수)
# 터미널에서 openssl rand -hex 32 실행 후 나온 값
# Vercel 대시보드 → Settings → Environment Variables 에서 설정
# CRON_SECRET="openssl rand -hex 32 로 생성한 랜덤 문자열"

# OpenAI - AI 맞춤 숙소 추천 (gpt-4o-mini)
# https://platform.openai.com/api-keys 에서 API 키 발급
# OPENAI_API_KEY="sk-..."

# Beds24 API (Phase 1 전용, iCal 연동에는 불필요)
# 공용(기본) Beds24 API V2 Refresh Token. docs/Beds24-連携企画.md 참고.
# 숙소의 beds24AccountKey 가 비어 있으면 이 토큰으로 동작 (기존 호환).
# BEDS24_REFRESH_TOKEN=""
#
# 멀티 계정(호스트별 Beds24 계정) 지원: 숙소 편집(관리자 전용)에서 Account Key 를 설정하면
# 해당 숙소는 BEDS24_REFRESH_TOKEN_{KEY} env 를 사용합니다.
# Account Key 는 영문 대문자/숫자/밑줄만 허용 (예: HOST_TANAKA, ASAHISTAY).
# BEDS24_REFRESH_TOKEN_HOST_TANAKA=""
# BEDS24_REFRESH_TOKEN_ASAHISTAY=""
#
# (선택) 호스트 수가 많아지면 env 하나에 묶어서 관리 가능:
# BEDS24_REFRESH_TOKENS_JSON='{"HOST_TANAKA":"...","ASAHISTAY":"..."}'

# 통화 환율 (게스트 KRW / 호스트 JPY 표시용)
# 1 JPY = X KRW. 미설정 시 10 사용 (1엔 ≈ 10원)
# EXCHANGE_RATE_JPY_TO_KRW=10

# Vercel 배포 (선택)
# - CLI 직접 배포 (권장, 가장 확실): npm run deploy:cli
#   Vercel 대시보드 → 프로젝트 → Settings → General 에서 ID 복사
#   minbaktokyos (tokyominbak.net):
#     VERCEL_ORG_ID="team_1qdVcZtzKQGHJmkdtvE2xrHZ"
#     VERCEL_PROJECT_ID="prj_z477oVao1phDDrLMETtRQlkTXMYH"
#   chris-projects (airbnb-clone-six-hazel-53.vercel.app):
#     VERCEL_ORG_ID="team_ZSwD0UVtxOgbCA0KkP3lLGBf"
#     VERCEL_PROJECT_ID="prj_vOtK4fShQ4xp8d1N8kpYKFDNzN71"
# - Deploy Hook: push 후 배포 트리거. Vercel → Settings → Git → Deploy Hooks → main 브랜치용
#   VERCEL_DEPLOY_HOOK="https://api.vercel.com/v1/integrations/deploy/..."
# - API 토큰: Deploy Hook 없을 때. https://vercel.com/account/tokens
#   VERCEL_TOKEN="..."

# DeepL - 메시지 자동 번역 (한↔일). 미설정 시 원문만 표시
# Free 플랜: https://www.deepl.com/pro-api#developer (월 50만 문자 무료, 키가 :fx 로 끝남)
# DEEPL_AUTH_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx"

# Discord (결제 완료 시 채널로 알림). 서버 → 채널 설정 → 연동 → 웹후크 → URL 복사
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Slack (선택 - 결제 완료 시 운영 알림)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# PWA 웹 푸시 (호스트 결제 알림 등). npx web-push generate-vapid-keys 로 한 번 발급
# VAPID_PRIVATE_KEY=...
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=...

# Meta Pixel (Facebook/Instagram 광고 추적). 미설정 시 기본 ID 사용
# NEXT_PUBLIC_META_PIXEL_ID="1815598592627600"
# Meta Pixel 브라우저 디버그 콘솔 (Production 제외. Preview에서만 켤 때 1)
# NEXT_PUBLIC_META_PIXEL_DEBUG=1
# Meta Conversions API (서버 Purchase 등). Events Manager → 설정 → Conversions API → 액세스 토큰
# 1) Meta Events Manager → 데이터 소스(픽셀) → 설정 → Conversions API →「액세스 토큰 생성」
# 2) 로컬 .env / Vercel Production·Preview 환경 변수에 동일 값 설정:
# META_CAPI_ACCESS_TOKEN="EAA..."
# 토큰 미설정 시 Purchase는 브라우저 Pixel만 전송되고 서버 CAPI는 스킵됩니다.
# Vercel Logs에서 `[meta-ops] capi_purchase_skipped` + reason=META_CAPI_ACCESS_TOKEN_missing 확인
# (선택) Meta 테스트 이벤트 코드 — Events Manager → Test Events
# META_CAPI_TEST_EVENT_CODE=""
#
# Meta Commerce Catalog (meta-catalog-build Cron → Vercel Blob)
# - BLOB_READ_WRITE_TOKEN: CSV 업로드 필수 (docs/Vercel-Blob-설정.md)
# - NEXT_PUBLIC_APP_URL: link 컬럼용 (https://tokyominbak.net 권장)
# - CRON_SECRET: /api/cron/meta-catalog-build 인증 (Vercel Cron 자동 전달)
# 고정 피드 경로: meta/catalog/products.csv (Meta Catalog Scheduled Fetch URL 1회 등록)
# 운영 점검: npm run verify:meta-production-env
# 카탈로그 1회 생성: npm run meta:catalog-build (배포 후)
# Vercel Logs 필터: [meta-ops] (catalog_cron_* / capi_purchase_*)

# 채널톡 (고객 상담 채팅 위젯)
# 채널톡 관리자 → 채널 설정 → 연동에서 플러그인 키 복사
# NEXT_PUBLIC_CHANNEL_PLUGIN_KEY="e4545154-919d-4d8d-b05e-e72beb1b78b0"
# 결제 확정 후 봇 알림 발송용 Open API 키 (서버 전용, 데스크 → 설정 → API Key 관리에서 발급)
# CHANNEL_ACCESS_KEY=""
# CHANNEL_ACCESS_SECRET=""

# 블로그 자동 등록 (ChatGPT Custom GPT 등)
# POST /api/admin/blog/from-api 에서 x-api-key 또는 Authorization: Bearer 로 인증
# BLOG_AUTHOR_USER_ID 미설정 시 DB에서 첫 번째 admin 사용
# BLOG_AUTO_PUBLISH_API_KEY="openssl rand -hex 24 로 생성한 48자 문자열"
# BLOG_AUTHOR_USER_ID="cuid-of-admin-user"

