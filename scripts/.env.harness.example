# ============================================================
# Meta CAPI ↔ Beds24 하네스 전용 환경 변수
# ============================================================
# 사용법:
#   cp scripts/.env.harness.example scripts/.env.harness
#   # 아래 값을 채운 뒤:
#   npm run meta:capi-harness
#
# 보안: .env.harness는 .gitignore에 등록됨 (커밋 금지)
# ============================================================

# ── 실행 모드 ────────────────────────────────────────────────
# "dry-run"    : 전송 없이 페이로드만 출력 (아무 토큰 없어도 실행 가능)
# "test"       : META_CAPI_TEST_EVENT_CODE로 전송 (Events Manager 테스트 탭에서 확인)
# "production" : 실제 전송 (META_CAPI_ACCESS_TOKEN 필요)
HARNESS_MODE=test

# ── Meta CAPI 설정 ───────────────────────────────────────────
# Pixel ID (미설정 시 기본값 1815598592627600 사용)
# NEXT_PUBLIC_META_PIXEL_ID=1815598592627600

# 2단계 인증 해결 전: 테스트 이벤트 코드만으로 Events Manager에서 확인 가능
# Events Manager → 데이터 소스(픽셀) → 설정 → 테스트 이벤트 탭 → 코드 확인
META_CAPI_TEST_EVENT_CODE=TEST12345

# 2단계 인증 해결 후 발급한 정식 토큰 (해결 시까지 비워두세요)
# META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx

# ── Beds24 설정 ──────────────────────────────────────────────
# 우선순위: HARNESS_BEDS24_REFRESH_TOKEN > BEDS24_REFRESH_TOKEN_ASAHISTAY > BEDS24_REFRESH_TOKEN
# (기존 .env.local에 BEDS24_REFRESH_TOKEN_ASAHISTAY가 있으면 자동으로 사용됨)
HARNESS_BEDS24_REFRESH_TOKEN=

# Beds24 관리자 → Properties → 숙소 선택 → Settings → Property ID
HARNESS_BEDS24_PROP_ID=

# Beds24 관리자 → Properties → 숙소 선택 → Rooms → Room ID
HARNESS_BEDS24_ROOM_ID=

# 조회 기간: 오늘부터 N일 (기본 30)
HARNESS_BEDS24_DAYS_AHEAD=30

# ── 숙소 메타데이터 ──────────────────────────────────────────
# CAPI 이벤트에 포함될 content_ids, content_name
HARNESS_LISTING_ID=asahi-stay-tokyo
HARNESS_LISTING_NAME=Asahi Stay Tokyo

# CAPI event_source_url 기반 URL
HARNESS_EVENT_SOURCE_URL=https://tokyominbak.net

# ── 디버그 ──────────────────────────────────────────────────
# 에러 스택 트레이스 출력
# HARNESS_DEBUG=1
